@prefix datin: <https://w3id.org/datin/core/> .
@prefix preloaded: <https://w3id.org/datin/preloaded/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix onto: <https://w3id.org/listdb/onto#> .
@prefix chebi: <https://www.ebi.ac.uk/chebi/> .
@prefix qunit: <http://qudt.org/vocab/unit/> .


preloaded:kilonewton_meter a datin:Unit;
    rdfs:label "kilonewton meter";
    skos:closeMatch qunit:KiloN-M.
